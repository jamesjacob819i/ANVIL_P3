# Required: LLM API Keys (pick one or both)
GROQ_API_KEY=gsk_your_groq_key_here
GEMINI_API_KEY=your_gemini_key_here

# Required: GitHub token with repo scope (for PRs, commits, code reading)
GITHUB_TOKEN=ghp_your_github_token_here

# Optional: Web search for RCA agent
TAVILY_API_KEY=tvly_your_tavily_key_here

# Optional: Slack notifications
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url

# Optional: Linear for post-mortem tracking
LINEAR_API_KEY=lin_your_linear_key_here
